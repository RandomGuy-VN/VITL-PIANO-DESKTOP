{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VITL Piano Setup",
  "version": "1.0.0",
  "identifier": "com.vitlpiano.setup",
  "build": {
    "frontendDist": "web",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VITL Piano Setup",
        "width": 740,
        "height": 490,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": ["WebView2Loader.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
